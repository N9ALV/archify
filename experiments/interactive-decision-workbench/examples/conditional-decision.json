      "stage": "evaluate",
      "label": "Expected return hurdle",
      "left": {
        "label": "Expected",
        "value": 14,
        "unit": "%"
      },
      "operator": ">",
      "right": {
        "label": "Required",
        "value": 10,
        "unit": "%"
      },
      "outputs": {
        "pass": "portfolio_fit",
        "fail": "watch"
      }
    },
    {
      "id": "portfolio_fit",
      "kind": "number_compare",
      "stage": "evaluate",
      "label": "Portfolio exposure",
      "left": {
        "label": "Resulting exposure",
        "value": 6,
        "unit": "%"
      },
      "operator": "<=",
      "right": {
        "label": "Maximum",
        "value": 8,
        "unit": "%"
      },
      "outputs": {
        "pass": "implement",
        "fail": "watch"
      }
    },
    {
      "id": "implement",
      "kind": "outcome",
      "stage": "perform",
      "label": "Implement"
    },
    {
      "id": "watch",
      "kind": "outcome",
      "stage": "perform",
      "label": "Watch / reject"
    },
    {
      "id": "re_evaluate",
      "kind": "outcome",
      "stage": "evaluate",
      "label": "Re-evaluate"
    }
  ]
